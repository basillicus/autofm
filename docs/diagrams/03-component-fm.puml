@startuml autofm-component-fm
' activates new C4 style
!NEW_C4_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

SHOW_PERSON_OUTLINE()
AddRelTag("async", $lineStyle=DashedLine())
AddRelTag("sync", $lineStyle=SolidLine())
skinparam linetype ortho

title autofm - FM Pipeline Components

System_Boundary(SOURCES, "O-RAN Data Plane") {
    System_Ext(TELEMETRY, "Telemetry Export", "Per-ROP CSVs")
    System_Ext(ALARMS, "Alarm Feed", "X.733 labels")
}

Container_Boundary(FM, "autofm - FM pipeline") {
    Boundary(INGEST, "Ingest & Label") {
        Component(LOADER, "Loader", "autofm.data.loader", "Cell-centric multi-level join over the fdn topology")
        Component(LABELER, "Alarm Labeler", "autofm.data.labels", "Leakage-safe forecast labels")
        Component(FEATURES, "Windowing", "autofm.data.features", "Chronological split, scaling, windows")
    }
    Boundary(REPRESENT, "Represent & Fuse") {
        Component(MAE, "MAE Compressor", "autofm.model.compress", "Per-ROP representation + anomaly score")
        Component(GAT, "Topology GAT", "autofm.model.gat", "Graph-attention fusion; causal chain")
    }
    Boundary(DECIDE, "Forecast & Decide") {
        Component(PATCHTST, "PatchTST Backbone", "autofm.model.classifier", "Patch-based temporal attention")
        Component(HEADS, "Multi-task Heads", "autofm.model.heads", "Evidential type, localization, TTF")
    }
    Boundary(CALIBRATE, "Calibrate") {
        Component(CONFORMAL, "Conformal", "autofm.model.conformal", "Coverage-guaranteed prediction sets")
    }
}

System(ADVISORY, "Advisory Layer", "Correlates the calibrated prediction into a ranked advisory")

Rel_D(TELEMETRY, LOADER, "counters", "CSV")
Rel_D(ALARMS, LABELER, "labels", "CSV")
Rel_D(LOADER, LABELER, "frame")
Rel_D(LABELER, FEATURES, "labeled frame")
Rel_D(FEATURES, MAE, "windows")
Rel_D(MAE, GAT, "latent")
Rel_D(GAT, PATCHTST, "fused embeddings")
Rel_D(PATCHTST, HEADS, "window feature")
Rel_D(HEADS, CONFORMAL, "class scores")
Rel_D(CONFORMAL, ADVISORY, "calibrated prediction")

SHOW_LEGEND()
@enduml
