@startuml autofm-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include style.puml

System_Boundary(SOURCES, "Data Sources") {
    System_Ext(TELEMETRY, "Telemetry Export", "Per-ROP CSVs: infra, platform, RAN")
    System_Ext(ALARMS, "Alarm Feed", "X.733 fault events (labels)")
}

System(AUTOFM, "autofm", "Forecasts O-RAN faults from multi-level telemetry and raises calibrated, explainable advisories")

Person(USER, "Network Operator", "Acts on advisories")
System_Ext(AUTOMATION, "Automation System", "Closed-loop remediation")

Rel_D(TELEMETRY, AUTOFM, "streams counters", "CSV")
Rel_D(ALARMS, AUTOFM, "provides labels", "CSV")
Rel_D(AUTOFM, USER, "delivers advisory")
Rel_D(AUTOFM, AUTOMATION, "advisory for closed-loop action")

Lay_R(TELEMETRY, ALARMS)
Lay_R(USER, AUTOMATION)
@enduml
