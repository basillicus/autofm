@startuml autofm-component-advisory
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
!include style.puml

System(FM, "FM Prediction", "Fault type, uncertainty, localization, TTF, causal chain")

Container_Boundary(ADV, "autofm - advisory layer") {
    Component(BUS, "Analysis Bus", "autofm.advisory.bus", "Shared queue; pillars publish and read typed messages")
    Component(PM, "PM Pillar", "autofm.advisory.pm", "Maps the fault to SLA breach risk and horizon")
    Component(CM, "CM Pillar", "autofm.advisory.cm", "Ranks candidate remediation actions")
    Component(CORR, "Correlation Engine", "autofm.advisory.correlation", "Fuses FM + PM + CM into one ranked advisory")
}

Person(USER, "Network Operator", "Acts on advisories")

Rel_D(FM, BUS, "publishes prediction")
Rel_D(BUS, PM, "fault prediction")
Rel_D(BUS, CM, "fault prediction")
Rel_D(PM, CORR, "SLA risk")
Rel_D(CM, CORR, "candidate actions")
Rel_D(CORR, USER, "delivers ranked advisory")

Lay_R(PM, CM)
@enduml
