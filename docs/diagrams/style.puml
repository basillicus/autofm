' ============================================================================
' autofm - shared C4-PlantUML style
' ----------------------------------------------------------------------------
' A self-contained theme included by every autofm C4 diagram. Uses only the
' PUBLIC C4-PlantUML stdlib (via raw.githubusercontent.com in each diagram), so
' the diagrams render on any machine and on public GitHub CI with no external
' or private include server.
'
' Palette (plain hex values)
'   system / component   #0082f0  (blue)    border #78A8D8
'   container            #ff8c0a  (orange)  border #78A8D8
'   external_system      #767676  (grey)
'   person               #0B4F8A  (dark blue), white text
'   relationships        black line, black text
' ============================================================================

skinparam defaultFontName "Helvetica Neue, Helvetica, Arial, sans-serif"
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 6
skinparam nodesep 55
skinparam ranksep 65
skinparam linetype ortho

' ---- Palette globals -----------------------------------------------------
!global $OSS_BG_COLOR = "#0082f0"
!global $OSS_BORDER_COLOR = "#78A8D8"
!global $EXTERNAL_BG_COLOR = "#767676"
!global $EXTERNAL_BORDER_COLOR = "#767676"
!global $OSS_CONT_BG_COLOR = "#ff8c0a"
!global $OSS_CONT_BORDER_COLOR = "#78A8D8"

UpdateElementStyle("system",          $bgColor=$OSS_BG_COLOR,      $fontColor="#FFFFFF", $borderColor=$OSS_BORDER_COLOR)
UpdateElementStyle("component",       $bgColor=$OSS_BG_COLOR,      $fontColor="#FFFFFF", $borderColor=$OSS_BORDER_COLOR)
UpdateElementStyle("external_system", $bgColor=$EXTERNAL_BG_COLOR, $fontColor="#FFFFFF", $borderColor=$EXTERNAL_BORDER_COLOR)
UpdateElementStyle("container",       $bgColor=$OSS_CONT_BG_COLOR, $fontColor="#000000", $borderColor=$OSS_CONT_BORDER_COLOR)
UpdateElementStyle("person",          $bgColor="#0B4F8A",          $fontColor="#FFFFFF", $borderColor="#083A66")
UpdateBoundaryStyle($borderColor="#767676", $fontColor="#333333")

' ---- Relationships: black line + bold black label ------------------------
UpdateRelStyle($lineColor="#000000", $textColor="#000000")
skinparam ArrowThickness 1.1
skinparam ArrowFontColor #000000
skinparam ArrowFontSize 12
