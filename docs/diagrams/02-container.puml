@startuml autofm-container
' activates new C4 style
!NEW_C4_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()
AddRelTag("async", $lineStyle=DashedLine())
AddRelTag("sync", $lineStyle=SolidLine())
skinparam linetype ortho

title autofm - Container View

Person(ENGINEER, "ML Engineer / SRE", "Trains, tunes, operates")
Person(OPERATOR, "Network Operator", "Acts on advisories")

System_Boundary(SOURCES, "O-RAN Data Plane") {
    System_Ext(TELEMETRY, "Telemetry Export", "Per-ROP CSVs")
    System_Ext(ALARMS, "Alarm Feed", "X.733 labels")
}
System_Ext(AUTOMATION, "Automation System", "Closed-loop remediation")

System_Boundary(AUTOFM, "autofm") {
    Container(TRAIN, "Training Pipeline", "Python · PyTorch DDP", "Batch: ingest, label, represent, fuse, forecast, calibrate")
    Container(ADVISORY, "Advisory Service", "Python", "Serves calibrated predictions; correlates FM/PM/CM")
    ContainerQueue(BUS, "Analysis Bus", "in-process · broker-ready", "Typed FM/PM/CM messages")
    ContainerDb(DATASTORE, "Dataset Store", "CSV corpus", "Multi-level telemetry + alarms")
    ContainerDb(MODELSTORE, "Model Store", "checkpoints", "MAE + classifier weights, calibration state")
}

' sources populate the dataset store
Rel_D(TELEMETRY, DATASTORE, "exported to", "CSV")
Rel_D(ALARMS, DATASTORE, "exported to", "CSV")

' training path
Rel_Neighbor(ENGINEER, TRAIN, "launches")
Rel_D(DATASTORE, TRAIN, "reads windows", "file")
Rel_Neighbor(TRAIN, MODELSTORE, "writes")

' serving path
Rel_D(MODELSTORE, ADVISORY, "loads model", "file")
Rel_Neighbor(ADVISORY, BUS, "publishes", "", $tags="async")
Rel_D(ADVISORY, OPERATOR, "delivers advisory")
Rel_D(ADVISORY, AUTOMATION, "closed-loop", "API", $tags="async")

SHOW_LEGEND()
@enduml
