# autofm — per-environment cluster values (TEMPLATE).
#
# Copy this file to `.env` at the repo root and fill in your own values:
#     cp env/.env.example .env
#
# `.env` is git-ignored — NEVER commit real accounts or paths.
# Only this `.env.example` (with placeholders) is tracked.
#
# These are the values that differ per user / per cluster allocation and so
# must not be hard-coded in tracked files. Model and data settings do NOT belong
# here — they live in config.yaml (repo root). Get the values below from your
# team lead / cluster allocation.

# SLURM project account (used for -A / --account).
SLURM_ACCOUNT=<ACCOUNT>

# Absolute path to the team's shared, pre-built environment on Leonardo.
# Holds activate.sh, setup_env.sh, requirements.lock.
SHARED_ENV_PATH=<SHARED_ENV_PATH>

# Permanent project/work directory on the cluster (NOT $FAST — it is full).
PROJECT_PATH=<PROJECT_PATH>
